[Unit]
Description=Supervision de l'index DGFiP des numeros de TVA (SARANGE)
Documentation=file:///srv/devis-sarange/deploy/README.md

[Service]
Type=oneshot
User=sarange
Group=sarange
WorkingDirectory=/srv/devis-sarange
Environment=NODE_ENV=production
Environment=TVA_DGFIP_INDEX_PATH=/var/lib/sarange/dgfip/dgfip-vat-index.json
Environment=NODE_OPTIONS=--max-old-space-size=4096
ExecStart=/usr/bin/npm run check-dgfip-vat-index

# Code de sortie non nul si l'index est absent, obsolete (plus de sept jours),
# de volume anormalement faible, ou si une sonde fonctionnelle echoue.
SuccessExitStatus=0
TimeoutStartSec=600
