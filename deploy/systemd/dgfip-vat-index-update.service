[Unit]
Description=Mise a jour de l'index DGFiP des numeros de TVA (SARANGE)
Documentation=file:///srv/devis-sarange/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sarange
Group=sarange
WorkingDirectory=/srv/devis-sarange
Environment=NODE_ENV=production
# Repertoire PERSISTANT, hors du repertoire de deploiement (l'index survit aux
# mises en production) et accessible en lecture par l'application.
Environment=TVA_DGFIP_INDEX_PATH=/var/lib/sarange/dgfip/dgfip-vat-index.json
# Extraction complete : ~4,8 millions d'entrees a construire en memoire.
Environment=NODE_OPTIONS=--max-old-space-size=4096
ExecStart=/usr/bin/npm run update-dgfip-vat-index

# Le script sort en code non nul en cas d'echec : systemd marque alors l'unite
# en "failed", etat que la supervision doit surveiller
# (systemctl is-failed dgfip-vat-index-update.service).
SuccessExitStatus=0
TimeoutStartSec=1800

# Le verrou d'execution du script empeche deja deux mises a jour simultanees ;
# systemd n'en lance de toute facon qu'une a la fois pour une meme unite.
