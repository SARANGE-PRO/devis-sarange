rules_version = '2';

// ============================================================================
// FICHIER DE RÈGLES UNIQUE du projet Firebase `sarange-pro`.
// Couvre les trois apps qui partagent ce projet :
//   - devis-sarange   (users/{uid}/quotes|clients|catalogue|compta|comptaExports)
//   - sarange-métrage (users/{uid}/metrageDossiers)
//   - sarange-suivi   (commandes, commandes_corbeille)
// Ne déployer les règles QUE depuis ce dépôt :
//   firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // Compte Google du domaine @sarange.fr, email vérifié.
    function isSarange() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('(?i)^.+@sarange[.]fr$');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ---- devis-sarange : données cloisonnées par compte ----
    match /users/{userId}/quotes/{quoteId} {
      allow read, write: if isOwner(userId);
    }

    // Corbeille des devis : purge automatique après 30 jours, gérée côté
    // client (lib/firebase/quotes.js) à chaque ouverture de « Mes devis ».
    match /users/{userId}/quotes_corbeille/{quoteId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/clients/{clientId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/catalogue/{documentId} {
      allow read, write: if isOwner(userId);
    }

    // Onglet Compta : paramètres d'export Sage et historique des exports CSV.
    match /users/{userId}/compta/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/comptaExports/{exportId} {
      allow read, write: if isOwner(userId);
    }

    // ---- sarange-métrage : dossiers de métrage, cloisonnés par compte ----
    match /users/{userId}/metrageDossiers/{dossierId} {
      allow read, write: if isOwner(userId);
    }

    // Lecture transverse des dossiers de métrage (collectionGroup) pour le
    // mode admin de prodoutil : « Importer les volets d'un métrage ».
    // Réservée aux comptes Google @sarange.fr — jamais aux tablettes anonymes.
    match /{path=**}/metrageDossiers/{dossierId} {
      allow read: if isSarange();
    }

    // ---- Sessions de signature : SERVEUR UNIQUEMENT ----
    // Toutes les lectures/écritures passent par les routes API (Admin SDK,
    // qui ignore les règles). Aucun accès client n'est légitime.
    match /quoteSignatureSessions/{sessionId} {
      allow read, write: if false;
    }

    // ---- Bon de fin de chantier (PV de réception) : SERVEUR UNIQUEMENT ----
    // Même isolation que quoteSignatureSessions ci-dessus : la page publique
    // /reception/[token] et /reception-generale passent uniquement par les
    // routes API app/api/completion-certificates/*  (Admin SDK).
    match /completionSignatureSessions/{sessionId} {
      allow read, write: if false;
    }

    // Variante générale (sans devis lié, lien fixe donné aux poseurs) : même
    // isolation serveur-uniquement.
    match /genericCompletionSessions/{sessionId} {
      allow read, write: if false;
    }

    // ---- sarange-suivi : collections partagées par toute l'équipe ----
    match /commandes/{commandeId} {
      allow read, write: if isSarange();
    }

    match /commandes_corbeille/{trashId} {
      allow read, write: if isSarange();
    }

    // ---- sarange-prodoutil : production atelier ----
    // Tablettes atelier en connexion ANONYME (fournisseur Anonyme activé,
    // aucun login opérateur) : lecture + création + mise à jour. Les actions
    // DESTRUCTRICES (suppression d'OF/dossier) exigent un compte Google
    // @sarange.fr — c'est aussi la condition du mode admin dans l'app.
    match /Chantiers/{chantierId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isSarange();

      match /Unites/{uniteId} {
        allow read, create, update: if request.auth != null;
        allow delete: if isSarange();
      }
    }

    // Écoute globale des unités (collectionGroup) utilisée par prodoutil.
    match /{path=**}/Unites/{uniteId} {
      allow read: if request.auth != null;
    }
  }
}
